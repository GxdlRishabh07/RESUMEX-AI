# Environment Variables
# ---------------------
# Port for the Node.js Express server
PORT=8080

# Gemini API Key (Required for AI operations)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — Public/Anon key (safe for frontend)
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# Disable Vite Hot Module Replacement (HMR) if experiencing connection issues in dev
# DISABLE_HMR=true
