          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            setTimeout(() => { window.print(); window.close(); }, 500);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
