    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { Sparkles, Loader2, ArrowRight } from \'lucide-react\';\n\ninterface OptimizeButtonProps {\n  onClick: () => void;\n  isLoading: boolean;\n  disabled: boolean;\n}\n\nconst LOADING_MESSAGES = [\n  \'Extracting core ATS keywords from Job Description...\',\n  \'Analyzing resume experience gaps & strengths...\',\n  \'Rewriting bullet points with STAR action metrics...\',\n  \'Injecting high-impact domain competencies...\',\n  \'Formatting clean markdown & scoring ATS match...\',\n];\n\nexport const OptimizeButton: React.FC<OptimizeButtonProps> = ({ onClick, isLoading, disabled }) => {\n  const [msgIdx, setMsgIdx] = useState(0);\n\n  useEffect(() => {\n    if (!isLoading) {\n      setMsgIdx(0);\n      return;\n    }\n    const interval = setInterval(() => {\n      setMsgIdx((prev) => (prev + 1) % LOADING_MESSAGES.length);\n    }, 2200);\n\n    return () => clearInterval(interval);\n  }, [isLoading]);\n\n  return (\n    <div id=\"container-optimize-btn\" className=\"flex flex-col items-center justify-center my-6\">\n      <button\n        id=\"btn-optimize-main\"\n        type=\"button\"\n        onClick={onClick}\n        disabled={disabled || isLoading}\n        className={`relative group overflow-hidden w-full max-w-md px-8 py-4 rounded-2xl font-bold text-base shadow-2xl transition-all duration-300 transform active:scale-98 ${\n          isLoading\n            ? \'bg-slate-800 text-slate-300 border border-slate-700 cursor-wait\'\n            : disabled\n            ? \'bg-slate-800/60 text-slate-500 border border-slate-800 cursor-not-allowed shadow-none\'\n            : \'bg-gradient-to-r from-indigo-600 via-blue-600 to-emerald-500 text-white hover:shadow-indigo-500/25 hover:scale-[1.02] border border-indigo-400/30\'\n        }`}\n      >\n        {/* Glow effect on hover */}\n        {!disabled && !isLoading && (\n          <div className=\"absolute inset-0 bg-gradient-to-r from-indigo-500 via-blue-500 to-emerald-400 opacity-0 group-hover:opacity-20 transition-opacity blur-xl\" />\n        )}\n\n        <div className=\"relative flex items-center justify-center space-x-3\">\n          {isLoading ? (\n            <>\n              <Loader2 className=\"w-5 h-5 animate-spin text-indigo-400\" />\n              <div className=\"text-left\">\n                <span className=\"block font-semibold text-sm text-slate-100\">Optimizing Resume with Gemini...</span>\n                <span className=\"block text-[11px] text-slate-400 animate-pulse\">{LOADING_MESSAGES[msgIdx]}</span>\n              </div>\n            </>\n          ) : (\n            <>\n              <Sparkles className=\"w-5 h-5 text-amber-300 animate-bounce\" />\n              <span>Optimize Resume for ATS</span>\n              <ArrowRight className=\"w-5 h-5 text-indigo-200 group-hover:translate-x-1 transition-transform\" />\n            </>\n          )}\n        </div>\n      </button>\n\n      {/* Keyboard Shortcut Hint */}\n      {!isLoading && !disabled && (\n        <p className=\"mt-2 text-[11px] text-slate-500 flex items-center space-x-1\">\n          <span>Tip: Press</span>\n          <kbd className=\"px-1.5 py-0.5 text-[10px] bg-slate-800 border border-slate-700 rounded text-slate-300 font-mono\">\n            Ctrl\n          </kbd>\n          <span>+</span>\n          <kbd className=\"px-1.5 py-0.5 text-[10px] bg-slate-800 border border-slate-700 rounded text-slate-300 font-mono\">\n            Enter\n          </kbd>\n          <span>to optimize</span>\n        </p>\n      )}\n    </div>\n  );\n};\n"
    }
